{
  "devDependencies": {
    "nodemon": "^3.1.0",
    "sequelize-cli": "^6.6.2"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "pg": "^8.11.3",
    "redis": "^4.6.13",
    "sequelize": "^6.37.1",
    "yup": "^1.4.0"
  },
  "name": "inventory-system-backend",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "start:dev": "nodemon app.js",
    "db:create": "npx sequelize db:create",
    "db:migrate": "npx sequelize db:migrate",
    "db:create:model": "npx sequelize model:generate --name Delivery_Order_Receipt_Outstanding_Product --attributes deliveryOrderReceiptOutstandingId:integer,deliveryOrderProductId:integer,outstandingQuantity:integer",
    "db:create:migration": "npx sequelize migration:generate --name=add-constraint-delivery-order",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:seed:all": "npx sequelize db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo",
    "db:drop": "npx sequelize db:drop"
  },

# =============================================================================
# ERP SYSTEM BACKEND ENVIRONMENT CONFIGURATION - EXAMPLE
# =============================================================================
# Copy this file to .env and fill in the actual values for your environment
# This file serves as a template with example/default values

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# Image version tag (used in docker-compose build)
VERSION=1.0.0

# Port number for the application server
PORT=4000

# Base URL for API endpoints (update with your domain)
BASE_URL=https://your-domain.com/api

# CORS allowed origins (comma-separated, leave empty for all origins)
CORS_ORIGIN=https://your-frontend-domain.com

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION - POSTGRESQL
# -----------------------------------------------------------------------------
# PostgreSQL database connection settings
POSTGRE_USERNAME=postgres
POSTGRE_PASSWORD=your_db_password
POSTGRE_HOST=localhost
POSTGRE_DB=your_database_name
POSTGRE_PORT=5432

# Connection pool settings
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_SSL=false

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# Default password for new user accounts
DEFAULT_PASSWORD=qwerty

# Application secret key for encryption/decryption (generate a strong random key)
APP_SECRET_KEY=your_app_secret_key_here

# JWT (JSON Web Token) configuration
TOKEN_KEY=your_token_key
REFRESH_TOKEN_KEY=your_refresh_token_key

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# SMTP email settings for system notifications
EMAIL_IS=your_email@example.com
EMAIL_PASSWORD_IS=your_email_app_password
EMAIL_RECEIVER=recipient@example.com
EMAIL_RECEIVER_BCC=bcc_recipient@example.com

# -----------------------------------------------------------------------------
# PRINTING CONFIGURATION
# -----------------------------------------------------------------------------
# Protocol for printer communication
PRINTER_PROTOCOL=http
